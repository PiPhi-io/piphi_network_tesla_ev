      "actions": [
        {
          "id": "refresh",
          "label": "Refresh Tesla readings",
          "description": "Ask Tesla for the latest vehicle status and publish an updated reading.",
          "capability": "action.refresh",
          "runtime": {
            "command": "refresh"
          },
          "targeting": {
            "modes": [
              "picked_devices",
              "by_integration"
            ],
            "minTargets": 1,
            "maxTargets": 1
          },
          "failure": {
            "strategy": "retry_then_continue",
            "retry": {
              "maxAttempts": 2,
              "delaySeconds": 5,
              "timeoutSeconds": 15,
              "backoff": "fixed"
            }
          },
          "ui": {
            "group": "do_this"
          },
          "safety": {
            "riskLevel": "low"
          }
        },
        {
          "id": "wake_up",
          "label": "Wake the vehicle",
          "description": "Wake a sleeping Tesla so a later step can get fresh readings.",
          "capability": "action.wake_up",
          "runtime": {
            "command": "wake_up"
          },
          "targeting": {
            "modes": [
              "picked_devices",
              "by_integration"
            ],
            "minTargets": 1,
            "maxTargets": 1
          },
          "failure": {
            "strategy": "retry_then_stop",
            "retry": {
              "maxAttempts": 2,
              "delaySeconds": 10,
              "timeoutSeconds": 30,
              "backoff": "fixed"
            }
          },
          "ui": {
            "group": "do_this"
          },
          "safety": {
            "riskLevel": "medium"
          }
        }
      ],
