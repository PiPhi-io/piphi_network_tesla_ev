      "category": "Vehicle care",
      "deviceKey": "tesla_vehicle",
      "config": {
        "automation_schema_version": "automation.behavior.v2",
        "triggers": [
          {
            "id": "state_changed",
            "label": "Tesla reading changes",
            "type": "integration_event",
